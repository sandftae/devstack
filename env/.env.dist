#-----------------------------------------------------------------------
# DOCKER ENV CONFIGURATION
#
# NOTE:
#   Please, use make cli command to change values of the file
#-----------------------------------------------------------------------
# either DEVELOPER, or PRODUCTION, or DEFAULT.
# You can change the mode in two ways:
#   1. manualy here. Then you need to rebuild the nginx container
#      container by docker command and re-run `make up`
#   2. by make command, just run either:
#       - make mode-developer
#       - make mode-production
#   this will rebuild nginx container
ADOBE_COMMERCE_MODE=developer

# By default the Varnish storing and processing mechanism is
# silenced (just bypassed, it means).
# The Varnish service is up, but the data is not processed or
# stored by Varnish.
# The value MUST BE LOWERCASE string "true" or "false", where:
#   - "true"    <------------ varnsih is silenced (bypassed)
#   - "false"   <------------ varnsih is unsilenced (bypassed)
#
# By default, it is:
#   - DEVELOPER_MODE_BYPASS_VARNISH="true" <----- for DEVELOPER mode
#   - DEVELOPER_MODE_BYPASS_VARNISH="FALSE" <----- for PRODUCTION mode
#
# At the same time you can manage values of this var being in
# PRODUCTION mode: make varnish silence-true
DEVELOPER_MODE_BYPASS_VARNISH="true"

#-----------------------------------------------------------------------
# Headless storefront configurations
#-----------------------------------------------------------------------

# Changing node version here you need to change value for this var
# 'NODE_OPTIONS_OPEN_SSL' as well, otherwise you will get errors
# when trying to run yarn/npm istall/build.
# Use make mode command to cahnge both of vars NODE_VERSION and
# NODE_OPTIONS_OPEN_SSL
NODE_VERSION=20-alpine

#  ---------------------------------------------------------------------
# | node >= 17  |   NODE_OPTIONS_OPEN_SSL=--openssl-legacy-provider    |
# | node <  17  |   NODE_OPTIONS_OPEN_SSL=                             |
#  ---------------------------------------------------------------------
NODE_OPTIONS_OPEN_SSL=--openssl-legacy-provider

# php-fpm xdebug enable/disable flag
XDEBUG_ENABLED=true

#-----------------------------------------------------------------------
# MySQL default configurations
#-----------------------------------------------------------------------
MYSQL_PASSWORD=root

#-----------------------------------------------------------------------
# opensearch default password
#-----------------------------------------------------------------------
OPENSEARCH_DASHBOARD_PASSWORD=admin
COMPOSE_PROJECT_NAME=devstack

#-----------------------------------------------------------------------
# php-fpm configurations
##-----------------------------------------------------------------------
EXPOSE_PORT=9000

#-----------------------------------------------------------------------
# varnish configurations
#-----------------------------------------------------------------------
VARNISH_TRANSIENT_STORAGE_AMOUNT=2G
VARNISH_WORKSPACE_BACKEND=256k
VARNISH_WORKSPACE_CLIENT=256k
VARNISH_NUKE_LIMIT=9999999
VARNISH_RESP_HDR_LEN=65536
VARNISH_STORAGE_AMOUNT=2G
VARNISH_CONSOLE_PORT=2000
VARNISH_MAX_THREADS=5000
VARNISH_RESP_SIZE=98304
VARNISH_SESS_TIMEOUT=20
VARNISH_MIN_THREADS=100
VARNISH_REQ_HDR_LEN=8k
VARNISH_EXPOSE_PORT=80
VARNISH_REQ_SIZE=32k
VARNISH_PORT=80

#-----------------------------------------------------------------------
# mailstorage configurations
#-----------------------------------------------------------------------
STORAGE=maildir
MAILDIR_PATH=/mnt/storage

#-----------------------------------------------------------------------
# sys configurations
#-----------------------------------------------------------------------
# terminal config just to make it more readable
PSI='\[\e[1;34;4;53m\]\u\[\e[0;2;4;53m\]@\[\e[0;1;4;53m\]\w\[\e[0;1;4;53m\] >\[\e[0m\] '
LD_PRELOAD=/usr/lib/preloadable_libiconv

#-----------------------------------------------------------------------
# nginx service configurations
#-----------------------------------------------------------------------
NGINX_USER=www
