## =====================================================================
## =====================================================================
##
## ADOBE COMMENRCE INSTANCE CONFIGURATION SECTION
##
## These vars are used to configure bin/magento setup:install command
##
## =====================================================================
## =====================================================================

#-----------------------------------------------------------------------
# COMMERCE SETUP:INSTALL STEP BASE VARIABLES
#
# NOTE:
#   Please use 'BASE_URL=https://dev-env.localhost/' because this is
#   the url value nginx and proxy servers listen on.
#-----------------------------------------------------------------------

# this is default database name, you can put your db name
DB_NAME=devstack_magento
DB_USER=root
DB_PASSWORD=root
BACKEBD_FRONTNAME=admin
LNAGUAGE=en_US
CURRENCY=USD
TIMEZONE=America/Chicago
USE_REWRITE=1

# thi is used for both setup:install steps and create new admin step,
# so you just need to change these params only
ADMIN_FIRSTNAME=admin
ADMIN_LASTNAME=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_USER=admin
ADMIN_PASSWORD=admin12345

#-----------------------------------------------------------------------
# COMMERCE SETUP:INSTALL STEP SEARCH ENGINE VARIABLES
#-----------------------------------------------------------------------

#-----------------------------------------------------------------------
#
# OpenSearch configuration section
#
#-----------------------------------------------------------------------
SEARCH_ENGINE=opensearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento2

## =====================================================================
## =====================================================================
