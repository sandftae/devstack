name: Infrastructure Stability

on:
  pull_request:
    branches: [main, development]
  push:
    branches: [main, development]
  # manual trigger enabled
  workflow_dispatch:

jobs:
  smoke-test:
    name: Infrastructure Smoke Test
    runs-on: ubuntu-latest
    env:
      # set terminal type to avoid 'tput: No value for $TERM' warnings
      TERM: xterm
      # disable Docker BuildKit for better performance and caching
      DOCKER_BUILDKIT: 0
      COMPOSE_DOCKER_CLI_BUILD: 0

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Generate Configurations
        run: |
          # generate environment files and docker-compose.yml
          docker compose -f ./env/compose.env-build.yml run --rm magma bash ./scripts/smoke/smoke

      - name: Verify Generated Files
        run: |
          # ensure that critical configuration files were created
          FILES=("env/.commerce.env" "env/.docker.env" "env/compose.yml")
          for file in "${FILES[@]}"; do
            if [ ! -f "$file" ]; then
              echo "Error: $file was not generated!"
              exit 1
            fi
          done
          echo "Verification successful: All files exist."

      - name: Start Infrastructure
        run: |
          sudo mkdir -p log/devstack
          sudo chmod -R 777 log
          # start all services defined in the generated compose file
          make up || {
            echo "Critical failure during make up";
            exit 1;
          }

      - name: Wait for Services
        run: |
          echo "Waiting for containers to reach 'running' state..."
          # list of services to monitor
          SERVICES=(
            "nginx" "ssl-reverse-proxy" "php-app" "web-app"
            "mysql" "mailpit" "varnish" "opensearch"
            "valkey" "sftp" "rabbitmq" "phpmyadmin" "logs"
          )

          for i in {1..24}; do
            ALL_RUNNING=true
            for svc in "${SERVICES[@]}"; do
              STATUS=$(docker inspect --format='{{.State.Status}}' "$svc" 2>/dev/null || echo "missing")
              if [ "$STATUS" != "running" ]; then
                echo "Wait: $svc is [$STATUS]..."
                ALL_RUNNING=false
                break
              fi
            done

            if [ "$ALL_RUNNING" = true ]; then
              echo "Success: all containers are up!"
              docker ps
              exit 0
            fi
            sleep 5
          done

          echo "Error: timeout reached."
          docker ps -a
          exit 1

      - name: HTTP & SSL Health Check
        run: |
          # verify that the web server is reachable via HTTPS
          echo "Performing HTTPS reachability check..."
          curl -v -k --fail --retry 10 --retry-delay 5 \
               --resolve mage-dev.localhost:443:127.0.0.1 \
               https://mage-dev.localhost/devstack/ > /dev/null 2>&1 || exit 1

      - name: Cleanup on Failure
        # collect logs if any of the previous steps failed
        if: failure()
        run: |
          echo "Infrastructure failed. Dumping container logs..."
          if [ -f "env/compose.yml" ]; then
            docker compose -f env/compose.yml logs --tail=100
          fi
